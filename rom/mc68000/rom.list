                            	   143: ;-----------------------------------------------------------------------
                            	   144: ; Subroutine: b_get_dec_number
                            	   145: ; Inputs:     A0 points to ascii
                            	   146: ; Outputs:    D0.l contains the number (32 bits), D1 contains the number
                            	   147: ;             of digits it consumed (so is 0 when NAN)
                            	   148: ;             A0 remains (1) the same if NAN or (2) points after number
                            	   149: ;-----------------------------------------------------------------------
                            	   150: b_get_dec_number
00:00010A12 2F02            	   151: 	move.l	D2,-(SP)
00:00010A14 4280            	   152: 	clr.l	D0		; will contain end result
00:00010A16 4281            	   153: 	clr.l	D1		; is zero if NAN
00:00010A18 0C100030        	   154: .start	cmp.b	#'0',(A0)
00:00010A1C 65000022        	   155: 	blo	.end
00:00010A20 0C100039        	   156: 	cmp.b	#'9',(A0)
00:00010A24 6200001A        	   157: 	bhi	.end
00:00010A28 2400            	   158: 	move.l	D0,D2		; times ten: first save D0 into D2
00:00010A2A E580            	   159: 	asl.l	#2,D0		; double D0
00:00010A2C D082            	   160: 	add.l	D2,D0		; now D0 is times 5
00:00010A2E E380            	   161: 	asl.l	#1,D0		; double D0 (times 10)
00:00010A30 1418            	   162: 	move.b	(A0)+,D2
00:00010A32 02820000000F    	   163: 	andi.l	#$f,D2
00:00010A38 D082            	   164: 	add.l	D2,D0
00:00010A3A 5281            	   165: 	addq.l	#1,D1
00:00010A3C 6000FFDA        	   166: 	bra	.start
00:00010A40 241F            	   167: .end	move.l	(SP)+,D2
00:00010A42 4E75            	   168: 	rts
