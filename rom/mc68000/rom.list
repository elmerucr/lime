                            	    73: ; ----------------------------------------------------------------------
                            	    74: ; Subroutine: b_double_dabble (bin to bcd)
                            	    75: ; Inputs:     D0.l 32bits unsigned value
                            	    76: ; Outputs:    D0-D1 combined holding 10 bcd's, big endian order
