                            	    72: ; ----------------------------------------------------------------------
                            	    73: ; Routine: b_double_dabble (bin to bcd)
                            	    74: ; Inputs:  D0.l 32bits unsigned value
                            	    75: ; Outputs: D0-D1 combined holding 10 bcd's, big endian order
                            	    76: ; ----------------------------------------------------------------------
                            	    77: b_double_dabble
00:0001098A 48E73000        	    78: 	movem.l	D2-D3,-(SP)
00:0001098E 761F            	    79: 	moveq	#32-1,D3	; counter for 32 shifts
00:00010990 2400            	    80: 	move.l	D0,D2		; D2 now holds input value
00:00010992 7000            	    81: 	moveq	#0,D0
00:00010994 7200            	    82: 	moveq	#0,D1
