                            	   130: ;-----------------------------------------------------------------------
                            	   131: ; Subroutine: b_remove_spaces
                            	   132: ; Inputs:     A0 pointer to text in buffer
                            	   133: ; Outputs:    A0 point to first item not equal to space ($20)
                            	   134: ;-----------------------------------------------------------------------
                            	   135: b_remove_spaces
00:00010A06 0C100020        	   136: 	cmp.b	#' ',(A0)
00:00010A0A 6604            	   137: 	bne.s	.end
00:00010A0C 5288            	   138: 	addq.l	#1,A0
00:00010A0E 60F6            	   139: 	bra.s	b_remove_spaces
00:00010A10 4E75            	   140: .end	rts
