00:0001080E 6600000A        	   797: 	bne	.end		; something was printed already
00:00010812 103C0030        	   798: 	move.b	#'0',d0		; nothing printed yet, so print 0
00:00010816 6100FE54        	   799: 	bsr	t_putchar
