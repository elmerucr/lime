                            	   660: 
00:000106DA 5241            	   661: .right	addq.w	#1,D1			; move cursor one step to the right
00:000106DC 3001            	   662: 	move.w	D1,D0
00:000106DE 0240007F        	   663: 	andi.w	#%1111111,D0
00:000106E2 B07C0050        	   664: 	cmp.w	#T_WIDTH,D0	; are we at pos 80 or higher?
00:000106E6 65000022        	   665: 	blo	.2			; no
                            	   666: 
00:000106EA 06410080        	   667: .lf	addi.w	#T_HPITCH,D1	; yes, move cursor one line down, followed by carriage return
00:000106EE 0241FF80        	   668: .cr	andi.w	#%1111111110000000,D1	; cursor to beginning of line (carriage return)
                            	   669: 
00:000106F2 B27C0A00        	   670: .1	cmp.w	#(T_HPITCH*T_HEIGHT),D1	; check for cursor out of screen
00:000106F6 65000012        	   671: 	blo	.2			; no
                            	   672: 
