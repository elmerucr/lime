                            	   142: ;-----------------------------------------------------------------------
                            	   143: ; Subroutine: b_get_dec_number
                            	   144: ; Inputs:     A0 points to ascii
                            	   145: ; Outputs:    D0.l contains the number (32 bits), D1 contains the number
                            	   146: ;             of digits it consumed (so is 0 when NAN)
                            	   147: ;             A0 remains (1) the same if NAN or (2) points after number
                            	   148: ;-----------------------------------------------------------------------
