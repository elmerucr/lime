00:00010A2A 528A            	   143: 	addq.l	#1,A2		; it was zero, so advance pointer to skip token value
00:00010A2C 6000FFE0        	   144: 	bra	.loop_keywords	; try next keyword
                            	   145: 
                            	   146: .match_found
00:00010A30 1012            	   147: 	move.b	(A2),D0		; load token value into D0
00:00010A32 204B            	   148: 	movea.l	A3,A0		; advance original A0 pointer
