00:00010A8E 1018            	    78: 	move.b	(A0)+,D0
00:00010A90 6700003E        	    79: 	beq	.done		; if null ($00), end of line (regardless D2 flag)
                            	    80: 
00:00010A94 B03C0022        	    81: 	cmp.b	#$22,D0		; check start/stop string mode
00:00010A98 66000006        	    82: 	bne	.1
00:00010A9C 0A020001        	    83: 	eor.b	#1,D2
                            	    84: 
00:00010AA0 4A02            	    85: .1	tst.b	D2
