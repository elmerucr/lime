00:00010594 22790000604E    	   540: 	movea.l	terminal_colors,A1
00:0001059A 323900006046    	   541: 	move.w	cursor_pos,D1
                            	   542: 
00:000105A0 B03C000A        	   543: 	cmp.b	#$0a,D0			; check for linefeed
00:000105A4 6700004E        	   544: 	beq	.lf
00:000105A8 B03C000D        	   545: 	cmp.b	#$0d,D0			; check for carriage return
00:000105AC 6700004A        	   546: 	beq	.cr
00:000105B0 B03C001D        	   547: 	cmp.b	#$1d,D0			; cursor right
00:000105B4 6700002E        	   548: 	beq	.right
00:000105B8 B03C0011        	   549: 	cmp.b	#$11,D0			; cursor down
00:000105BC 6700005E        	   550: 	beq	.down
00:000105C0 B03C0091        	   551: 	cmp.b	#$91,D0			; cursor up
00:000105C4 67000060        	   552: 	beq	.up
00:000105C8 B03C009D        	   553: 	cmp.b	#$9d,D0			; cursor left
00:000105CC 67000064        	   554: 	beq	.left
00:000105D0 B03C0008        	   555: 	cmp.b	#$08,D0			; backspace
00:000105D4 6700007A        	   556: 	beq	.bs
                            	   557: 
00:000105D8 11801000        	   558: 	move.b	D0,(A0,D1.w)		; print char
00:000105DC 13B9000060481000	   559: 	move.b	cursor_color,(A1,D1.w)	; set color
                            	   560: 
00:000105E4 5241            	   561: .right	addq.w	#1,D1			; move cursor one step to the right
00:000105E6 3001            	   562: 	move.w	D1,D0
00:000105E8 0240007F        	   563: 	andi.w	#%1111111,D0
00:000105EC B07C0050        	   564: 	cmp.w	#TERMINAL_WIDTH,D0	; are we at pos 80 or higher?
00:000105F0 65000022        	   565: 	blo	.2			; no
                            	   566: 
00:000105F4 06410080        	   567: .lf	addi.w	#TERMINAL_HPITCH,D1	; yes, move cursor one line down, followed by carriage return
00:000105F8 0241FF80        	   568: .cr	andi.w	#%1111111110000000,D1	; cursor to beginning of line (carriage return)
                            	   569: 
00:000105FC B27C0A00        	   570: .1	cmp.w	#(TERMINAL_HPITCH*TERMINAL_HEIGHT),D1	; check for cursor out of screen
