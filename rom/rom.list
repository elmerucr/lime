00:00010A70 48E72000        	    76: 	movem.l	d2,-(sp)
00:00010A74 4202            	    77: 	clr.b	d2		; D2 is flag for string copy mode
                            	    78: 
                            	    79: .start
00:00010A76 1018            	    80: 	move.b	(a0)+,d0
00:00010A78 6700003E        	    81: 	beq	.done		; if null ($00), end of line (regardless D2 flag)
                            	    82: 
00:00010A7C B03C0022        	    83: 	cmp.b	#$22,d0		; check start/stop string mode
00:00010A80 66000006        	    84: 	bne	.1
00:00010A84 0A020001        	    85: 	eor.b	#1,d2
                            	    86: 
00:00010A88 4A02            	    87: .1	tst.b	d2
00:00010A8A 66000020        	    88: 	bne	.copy_raw	; we're in string mode
                            	    89: 
                            	    90: 
                            	    91: 	; check for letter
00:00010A8E B03C0061        	    92: 	cmp.b	#'a',d0
00:00010A92 65000018        	    93: 	blo	.copy_raw
00:00010A96 B03C007A        	    94: 	cmp.b	#'z',d0
00:00010A9A 62000010        	    95: 	bhi	.copy_raw
                            	    96: 
                            	    97: 	; it's a letter: see if there's a match
00:00010A9E 5348            	    98: 	subq	#1,a0		; make sure A0 points again to start of potential keyword
00:00010AA0 6100001E        	    99: 	bsr	b_check_keyword
00:00010AA4 4A00            	   100: 	tst.b	d0		; did we find a token? d0 != 0
00:00010AA6 6600000A        	   101: 	bne	.write_token	; yes, go write it
                            	   102: 
                            	   103: 	; if it wasn't, restore char and copy as raw text
00:00010AAA 1018            	   104: 	move.b	(a0)+,d0
                            	   105: 
