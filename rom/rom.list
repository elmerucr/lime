00:00010A00 12C0            	   105: 	move.b	D0,(A1)+
00:00010A02 6000FFC6        	   106: 	bra	.start
                            	   107: 
                            	   108: .write_token
00:00010A06 12C0            	   109: 	move.b	D0,(A1)+
00:00010A08 6000FFC0        	   110: 	bra	.start
                            	   111: 
00:00010A0C 12C0            	   112: .done	move.b	D0,(A1)+
00:00010A0E 4CDF0004        	   113: 	movem.l	(SP)+,D2
