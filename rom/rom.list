00:00010464 6700005E        	   455: 	beq	.end
00:00010468 11C00400        	   456: 	move.b	D0,VDC_SR.w			; acknowledge irq
                            	   457: 
00:0001046C 103900006044    	   458: 	move.b	logo_animation,D0
00:00010472 5200            	   459: 	addq.b	#$1,D0
00:00010474 B03C00B8        	   460: 	cmp.b	#$b8,D0				; did we reach x position $b8?
00:00010478 6600000E        	   461: 	bne	.1				; no jump to .1
00:0001047C 13FC000100000481	   462: 	move.b	#%00000001,CORE_CR		; yes, activate irq's for binary insert (each time we reach $b8)
                            	   463: 						; this makes sure letters wobble at least 1 time before binary
                            	   464: 						; load process starts
00:00010484 103C0048        	   465: 	move.b	#$48,D0				; reset x position to $48
                            	   466: 
00:00010488 13C000006044    	   467: .1	move.b	D0,logo_animation
                            	   468: 
00:0001048E 123C0001        	   469: 	move.b	#1,D1				; start with sprite 1 (letter 'l')
00:00010492 13C100000407    	   470: .2	move.b	D1,VDC_CURRENT_SPRITE
