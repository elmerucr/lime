00:000107D6 7609            	   775: 	moveq	#10-1,d3	; max 10 digits
00:000107D8 1400            	   776: .start	move.b	d0,d2
00:000107DA E80A            	   777: 	lsr.b	#4,d2		; d2.b now holds a number
00:000107DC 66000006        	   778: 	bne	.print		; it's a 1 or higher
00:000107E0 4A04            	   779: 	tst.b	d4		; it's a 0, but check if it must printed
00:000107E2 6714            	   780: 	beq.s	.cont		; no, go to .cont
00:000107E4 7801            	   781: .print	moveq	#1,d4
00:000107E6 06020030        	   782: 	addi.b	#$30,d2
00:000107EA 48E7C000        	   783: 	movem.l	d0-d1,-(sp)
