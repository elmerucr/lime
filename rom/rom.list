                            	   563: ; ----------------------------------------------------------------------
                            	   564: ; Subroutine: t_putchar
                            	   565: ; Inputs:     D0 contains char to be printed
                            	   566: ; Outputs:    -
                            	   567: ; Destroyed:  D0,D1,A0,A1
                            	   568: ; ----------------------------------------------------------------------
                            	   569: t_putchar
00:000105A2 20790000604A    	   570: 	movea.l	t_chars,A0
00:000105A8 22790000604E    	   571: 	movea.l	t_colors,A1
00:000105AE 323900006046    	   572: 	move.w	cursor_pos,D1
                            	   573: 
00:000105B4 B03C000A        	   574: 	cmp.b	#$0a,D0			; check for linefeed
00:000105B8 6700004E        	   575: 	beq	.lf
00:000105BC B03C000D        	   576: 	cmp.b	#$0d,D0			; check for carriage return
00:000105C0 6700004A        	   577: 	beq	.cr
00:000105C4 B03C001D        	   578: 	cmp.b	#$1d,D0			; cursor right
00:000105C8 6700002E        	   579: 	beq	.right
00:000105CC B03C0011        	   580: 	cmp.b	#$11,D0			; cursor down
00:000105D0 6700005E        	   581: 	beq	.down
00:000105D4 B03C0091        	   582: 	cmp.b	#$91,D0			; cursor up
00:000105D8 67000060        	   583: 	beq	.up
00:000105DC B03C009D        	   584: 	cmp.b	#$9d,D0			; cursor left
00:000105E0 67000064        	   585: 	beq	.left
00:000105E4 B03C0008        	   586: 	cmp.b	#$08,D0			; backspace
00:000105E8 6700007A        	   587: 	beq	.bs
