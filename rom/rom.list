                            	   117: ; ----------------------------------------------------------------------
                            	   118: ; Subroutine: b_check_keyword
                            	   119: ; Input:      A0 pointer to input string
                            	   120: ; Outputs:    D0 is $00 if no token found or token byte ($80-$ff) if found
                            	   121: ;             A0 untouched when no match, A0 points to after keyword if match
                            	   122: ; Destroyed:  D1
                            	   123: ; ----------------------------------------------------------------------
                            	   124: b_check_keyword
00:00010AC0 48E70030        	   125: 	movem.l	A2-A3,-(SP)
00:00010AC4 45F900010BE0    	   126: 	lea	b_token_table,A2
                            	   127: 
                            	   128: .loop_keywords
00:00010ACA 4A12            	   129: 	tst.b	(A2)		; check the first character from the keyword
00:00010ACC 67000028        	   130: 	beq	.not_found	; if $00, we hit end of table
00:00010AD0 2648            	   131: 	movea.l	A0,A3		; leave A0, use A3 for now
                            	   132: 
                            	   133: .compare_loop
00:00010AD2 121A            	   134: 	move.b	(A2)+,D1
00:00010AD4 67000016        	   135: 	beq	.match_found	; we came this far and character = null = match found
00:00010AD8 101B            	   136: 	move.b	(A3)+,D0	; get character from input buffer
00:00010ADA B200            	   137: 	cmp.b	D0,D1		; compare chars case sensitive
00:00010ADC 6700FFF4        	   138: 	beq	.compare_loop
                            	   139: 
