00:00010BA0 D082            	   262: 	add.l	d2,d0		; now D0 is times 5
00:00010BA2 E380            	   263: 	asl.l	#1,d0		; double D0 (times 10)
00:00010BA4 1418            	   264: 	move.b	(a0)+,d2
