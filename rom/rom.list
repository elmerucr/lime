00:00010710 4E75            	   679: 	rts
                            	   680: 
00:00010712 06410080        	   681: .down	addi.w	#T_HPITCH,D1	; yes, move cursor one line down
00:00010716 6000FFDA        	   682: 	bra	.1
00:0001071A 4E75            	   683: 	rts
                            	   684: 
00:0001071C 04410080        	   685: .up	subi.w	#T_HPITCH,D1	; move cursor one line up
00:00010720 6AE8            	   686: 	bpl.s	.2
00:00010722 06410080        	   687: 	addi.w	#T_HPITCH,D1	; move cursor one line down
00:00010726 60E2            	   688: 	bra.s	.2
                            	   689: 
00:00010728 4A41            	   690: .left	tst.w	D1
00:0001072A 6602            	   691: 	bne.s	.l0
00:0001072C 4E75            	   692: 	rts
00:0001072E 3001            	   693: .l0	move.w	D1,D0
00:00010730 0240007F        	   694: 	andi.w	#$7f,D0
00:00010734 4A40            	   695: 	tst.w	D0
00:00010736 6600000A        	   696: 	bne	.l1
00:0001073A 0641004F        	   697: 	addi.w	#(T_WIDTH-1),D1
00:0001073E 6000FFDC        	   698: 	bra	.up
00:00010742 5341            	   699: .l1	subq.w	#1,D1
00:00010744 60C4            	   700: 	bra.s	.2
                            	   701: 
00:00010746 3001            	   702: .bs	move.w	D1,D0
