00:000106D2 06410080        	   661: .lf	addi.w	#T_HPITCH,d1	; yes, move cursor one line down, followed by carriage return
00:000106D6 0241FF80        	   662: .cr	andi.w	#%1111111110000000,d1	; cursor to beginning of line (carriage return)
                            	   663: 
00:000106DA B27C0A00        	   664: .1	cmp.w	#(T_HPITCH*T_HEIGHT),d1	; check for cursor out of screen
