                            	   460: 
00:0001046C 103900006044    	   461: 	move.b	logo_animation,d0
00:00010472 5200            	   462: 	addq.b	#$1,d0
00:00010474 B03C00B8        	   463: 	cmp.b	#$b8,d0				; did we reach x position $b8?
