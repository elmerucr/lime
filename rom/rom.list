                            	   117: ; ----------------------------------------------------------------------
                            	   118: ; Subroutine: b_check_keyword
                            	   119: ; Input:      A0 pointer to input string
                            	   120: ; Outputs:    D0 is $00 if no token found or token byte ($80-$ff) if found
                            	   121: ;             A0 untouched when no match, A0 points to after keyword if match
                            	   122: ; Destroyed:  D1
                            	   123: ; ----------------------------------------------------------------------
                            	   124: b_check_keyword
00:00010AD8 48E70030        	   125: 	movem.l	A2-A3,-(SP)
00:00010ADC 45F900010BF8    	   126: 	lea	b_token_table,A2
                            	   127: 
                            	   128: .loop_keywords
00:00010AE2 4A12            	   129: 	tst.b	(A2)		; check the first character from the keyword
00:00010AE4 67000028        	   130: 	beq	.not_found	; if $00, we hit end of table
00:00010AE8 2648            	   131: 	movea.l	A0,A3		; leave A0, use A3 for now
                            	   132: 
                            	   133: .compare_loop
00:00010AEA 121A            	   134: 	move.b	(A2)+,D1
00:00010AEC 67000016        	   135: 	beq	.match_found	; we came this far and character = null = match found
00:00010AF0 101B            	   136: 	move.b	(A3)+,D0	; get character from input buffer
00:00010AF2 B200            	   137: 	cmp.b	D0,D1		; compare chars case sensitive
00:00010AF4 6700FFF4        	   138: 	beq	.compare_loop
                            	   139: 
                            	   140: .skip_keyword
00:00010AF8 4A1A            	   141: 	tst.b	(A2)+		; test table byte and advance pointer
00:00010AFA 6600FFFC        	   142: 	bne	.skip_keyword	; repeat as it wasn't zero
00:00010AFE 528A            	   143: 	addq.l	#1,A2		; it was zero, so advance pointer to skip token value
00:00010B00 6000FFE0        	   144: 	bra	.loop_keywords	; try next keyword
                            	   145: 
                            	   146: .match_found
00:00010B04 1012            	   147: 	move.b	(A2),D0		; load token value into D0
00:00010B06 204B            	   148: 	movea.l	A3,A0		; advance original A0 pointer
00:00010B08 4CDF0C00        	   149: 	movem.l	(SP)+,A2-A3	; cleanup and return
00:00010B0C 4E75            	   150: 	rts
                            	   151: 
                            	   152: .not_found
00:00010B0E 7000            	   153: 	moveq	#0,D0		; no match, A0 not advanced
00:00010B10 4CDF0C00        	   154: 	movem.l	(SP)+,A2-A3	; cleanup and return
00:00010B14 4E75            	   155: 	rts
