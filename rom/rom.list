                            	   457: ; Subroutine: exception vdc / letter wobble
                            	   458: ; -----------------
                            	   459: exc_lvl6_irq_auto				; coupled to vdc
00:0001046E 1F3900000407    	   460: 	move.b	VDC_CURRENT_SPRITE,-(SP)
00:00010474 48E7C000        	   461: 	movem.l	D0-D1,-(SP)
                            	   462: 
00:00010478 10380400        	   463: 	move.b	VDC_SR.w,D0
00:0001047C 6700005E        	   464: 	beq	.end
00:00010480 11C00400        	   465: 	move.b	D0,VDC_SR.w			; acknowledge irq
                            	   466: 
00:00010484 103900006044    	   467: 	move.b	logo_animation,D0
00:0001048A 5200            	   468: 	addq.b	#$1,D0
00:0001048C B03C00B8        	   469: 	cmp.b	#$b8,D0				; did we reach x position $b8?
00:00010490 6600000E        	   470: 	bne	.1				; no jump to .1
00:00010494 13FC000100000481	   471: 	move.b	#%00000001,CORE_CR		; yes, activate irq's for binary insert (each time we reach $b8)
                            	   472: 						; this makes sure letters wobble at least 1 time before binary
                            	   473: 						; load process starts
00:0001049C 103C0048        	   474: 	move.b	#$48,D0				; reset x position to $48
                            	   475: 
00:000104A0 13C000006044    	   476: .1	move.b	D0,logo_animation
                            	   477: 
00:000104A6 123C0001        	   478: 	move.b	#1,D1				; start with sprite 1 (letter 'l')
00:000104AA 13C100000407    	   479: .2	move.b	D1,VDC_CURRENT_SPRITE
00:000104B0 13FC005C00000463	   480: 	move.b	#92,VDC_SPRITE_Y_LSB		; base position for each letter
                            	   481: 
00:000104B8 103900000461    	   482: 	move.b	VDC_SPRITE_X_LSB,D0		; store x for current sprite in D0
00:000104BE 903900006044    	   483: 	sub.b	logo_animation,D0		; subtract logo_an x value from D0
                            	   484: 
00:000104C4 B03C0008        	   485: 	cmp.b	#8,D0
00:000104C8 64000008        	   486: 	bcc	.3				; if more than 8, jump to .3
                            	   487: 
00:000104CC 533900000463    	   488: 	subq.b	#1,VDC_SPRITE_Y_LSB		; move letter up 1 pixel
                            	   489: 
00:000104D2 5241            	   490: .3	addq	#1,D1				; move to next sprite
00:000104D4 B23C0005        	   491: 	cmp.b	#5,D1				; did we reach sprite 5?
00:000104D8 6600FFD0        	   492: 	bne	.2				; not yet, jump to .2
                            	   493: 
00:000104DC 4CDF0003        	   494: .end	movem.l	(SP)+,D0-D1
00:000104E0 13DF00000407    	   495: 	move.b	(SP)+,VDC_CURRENT_SPRITE
00:000104E6 4E73            	   496: 	rte
