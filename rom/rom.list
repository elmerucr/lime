00:000107EE 7609            	   781: 	moveq	#10-1,D3	; max 10 digits
00:000107F0 1400            	   782: .start	move.b	D0,D2
00:000107F2 E80A            	   783: 	lsr.b	#4,D2		; D2.b now holds a number
00:000107F4 66000006        	   784: 	bne	.print		; it's a 1 or higher
00:000107F8 4A04            	   785: 	tst.b	D4		; it's a 0, but check if it must printed
00:000107FA 6714            	   786: 	beq.s	.cont		; no, go to .cont
00:000107FC 7801            	   787: .print	moveq	#1,D4
00:000107FE 06020030        	   788: 	addi.b	#$30,D2
00:00010802 48E7C000        	   789: 	movem.l	D0-D1,-(SP)
