00:000106A2 67000060        	   646: 	beq	.up
00:000106A6 B03C009D        	   647: 	cmp.b	#$9d,d0			; cursor left
00:000106AA 67000064        	   648: 	beq	.left
00:000106AE B03C0008        	   649: 	cmp.b	#$08,d0			; backspace
00:000106B2 6700007A        	   650: 	beq	.bs
                            	   651: 
