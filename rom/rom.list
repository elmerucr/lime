00:000103AE 5200            	   403: 	addq.b	#$1,D0
00:000103B0 B03C00B8        	   404: 	cmp.b	#$b8,D0				; did we reach x position $b8?
00:000103B4 6600000E        	   405: 	bne	.1				; no jump to .1
00:000103B8 13FC000100000481	   406: 	move.b	#%00000001,CORE_CR		; yes, activate irq's for binary insert (each time we reach $b8)
