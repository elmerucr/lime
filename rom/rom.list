                            	   526: ; ----------------------------------------------------------------------
                            	   527: ; Subroutine: terminal_putchar
                            	   528: ; Inputs:     D0 contains char to be printed
                            	   529: ; Outputs:    -
                            	   530: ; Destroyed:  D0,D1,A0,A1
                            	   531: ; ----------------------------------------------------------------------
                            	   532: terminal_putchar
00:00010574 20790000600A    	   533: 	movea.l	terminal_chars,A0
00:0001057A 22790000600E    	   534: 	movea.l	terminal_colors,A1
00:00010580 323900006006    	   535: 	move.w	cursor_pos,D1
                            	   536: 
00:00010586 B03C000A        	   537: 	cmp.b	#$0a,D0			; check for linefeed
00:0001058A 6700004E        	   538: 	beq	.lf
00:0001058E B03C000D        	   539: 	cmp.b	#$0d,D0			; check for carriage return
00:00010592 6700004A        	   540: 	beq	.cr
00:00010596 B03C001D        	   541: 	cmp.b	#$1d,D0			; cursor right
00:0001059A 6700002E        	   542: 	beq	.right
00:0001059E B03C0011        	   543: 	cmp.b	#$11,D0			; cursor down
00:000105A2 6700005E        	   544: 	beq	.down
00:000105A6 B03C0091        	   545: 	cmp.b	#$91,D0			; cursor up
00:000105AA 67000060        	   546: 	beq	.up
00:000105AE B03C009D        	   547: 	cmp.b	#$9d,D0			; cursor left
00:000105B2 67000064        	   548: 	beq	.left
00:000105B6 B03C0008        	   549: 	cmp.b	#$08,D0			; backspace
00:000105BA 6700007A        	   550: 	beq	.bs
                            	   551: 
00:000105BE 11801000        	   552: 	move.b	D0,(A0,D1.w)		; print char
00:000105C2 13B9000060081000	   553: 	move.b	cursor_color,(A1,D1.w)	; set color
                            	   554: 
00:000105CA 5241            	   555: .right	addq.w	#1,D1			; move cursor one step to the right
00:000105CC 3001            	   556: 	move.w	D1,D0
00:000105CE 0240007F        	   557: 	andi.w	#%1111111,D0
00:000105D2 B07C0050        	   558: 	cmp.w	#TERMINAL_WIDTH,D0	; are we at pos 80 or higher?
00:000105D6 65000022        	   559: 	blo	.2			; no
                            	   560: 
00:000105DA 06410080        	   561: .lf	addi.w	#TERMINAL_HPITCH,D1	; yes, move cursor one line down, followed by carriage return
00:000105DE 0241FF80        	   562: .cr	andi.w	#%1111111110000000,D1	; cursor to beginning of line (carriage return)
                            	   563: 
00:000105E2 B27C0A00        	   564: .1	cmp.w	#(TERMINAL_HPITCH*TERMINAL_HEIGHT),D1	; check for cursor out of screen
00:000105E6 65000012        	   565: 	blo	.2			; no
                            	   566: 
00:000105EA 04410080        	   567: 	subi.w	#TERMINAL_HPITCH,D1	; move cursor one line up
00:000105EE 33C100006006    	   568: 	move.w	D1,cursor_pos
00:000105F4 61000132        	   569: 	bsr	terminal_add_bottom_row
