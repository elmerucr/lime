                            	   642: 
00:00010696 B03C000A        	   643: 	cmp.b	#$0a,D0			; check for linefeed
00:0001069A 6700004E        	   644: 	beq	.lf
00:0001069E B03C000D        	   645: 	cmp.b	#$0d,D0			; check for carriage return
00:000106A2 6700004A        	   646: 	beq	.cr
