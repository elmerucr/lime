00:00010456 5848            	   443: 	addq	#4,A0
00:00010458 E300            	   444: 	asl.b	D0
00:0001045A 6700000C        	   445: 	beq	.3
00:0001045E 60EC            	   446: 	bra.s	.1
                            	   447: 
                            	   448: 	; code for dealing with this timer
