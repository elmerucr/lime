00:000107FC E381            	   789: 	asl.l	d1
00:000107FE E390            	   790: 	roxl.l	d0
00:00010800 E381            	   791: 	asl.l	d1
00:00010802 E390            	   792: 	roxl.l	d0
00:00010804 E381            	   793: 	asl.l	d1
