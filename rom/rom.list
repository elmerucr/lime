                            	   119: ; ----------------------------------------------------------------------
                            	   120: ; Subroutine: b_check_keyword
                            	   121: ; Input:      a0 pointer to input string
                            	   122: ; Outputs:    d0 is $00 if no token found or token byte ($80-$ff) if found
                            	   123: ;             a0 untouched when no match, A0 points to after keyword if match
                            	   124: ; Destroyed:  d1
                            	   125: ; ----------------------------------------------------------------------
                            	   126: b_check_keyword
00:00010AC0 48E70030        	   127: 	movem.l	a2-a3,-(sp)
00:00010AC4 45F900010BE0    	   128: 	lea	b_token_table,a2
                            	   129: 
                            	   130: .loop_keywords
00:00010ACA 4A12            	   131: 	tst.b	(a2)		; check the first character from the keyword
00:00010ACC 67000028        	   132: 	beq	.not_found	; if $00, we hit end of table
00:00010AD0 2648            	   133: 	movea.l	a0,a3		; leave a0, use a3 for now
                            	   134: 
                            	   135: .compare_loop
00:00010AD2 121A            	   136: 	move.b	(a2)+,d1
00:00010AD4 67000016        	   137: 	beq	.match_found	; we came this far and character = null = match found
00:00010AD8 101B            	   138: 	move.b	(a3)+,d0	; get character from input buffer
00:00010ADA B200            	   139: 	cmp.b	d0,d1		; compare chars case sensitive
00:00010ADC 6700FFF4        	   140: 	beq	.compare_loop
                            	   141: 
                            	   142: .skip_keyword
00:00010AE0 4A1A            	   143: 	tst.b	(a2)+		; test table byte and advance pointer
00:00010AE2 6600FFFC        	   144: 	bne	.skip_keyword	; repeat as it wasn't zero
00:00010AE6 528A            	   145: 	addq.l	#1,a2		; it was zero, so advance pointer to skip token value
00:00010AE8 6000FFE0        	   146: 	bra	.loop_keywords	; try next keyword
                            	   147: 
                            	   148: .match_found
00:00010AEC 1012            	   149: 	move.b	(a2),d0		; load token value into d0
00:00010AEE 204B            	   150: 	movea.l	a3,a0		; advance original a0 pointer
00:00010AF0 4CDF0C00        	   151: 	movem.l	(sp)+,a2-a3	; cleanup and return
00:00010AF4 4E75            	   152: 	rts
                            	   153: 
                            	   154: .not_found
00:00010AF6 7000            	   155: 	moveq	#0,d0		; no match, a0 not advanced
00:00010AF8 4CDF0C00        	   156: 	movem.l	(sp)+,a2-a3	; cleanup and return
00:00010AFC 4E75            	   157: 	rts
