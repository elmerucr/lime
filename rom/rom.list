00:00010A04 48E70030        	   125: 	movem.l	A2-A3,-(SP)
00:00010A08 45F900010B24    	   126: 	lea	b_token_table,A2
                            	   127: 
                            	   128: .loop_keywords
00:00010A0E 4A12            	   129: 	tst.b	(A2)		; check the first character from the keyword
00:00010A10 67000028        	   130: 	beq	.not_found	; if $00, we hit end of table
00:00010A14 2648            	   131: 	movea.l	A0,A3		; leave A0, use A3 for now
                            	   132: 
                            	   133: .compare_loop
00:00010A16 121A            	   134: 	move.b	(A2)+,D1
00:00010A18 67000016        	   135: 	beq	.match_found	; we came this far and character = null = match found
00:00010A1C 101B            	   136: 	move.b	(A3)+,D0	; get character from input buffer
00:00010A1E B200            	   137: 	cmp.b	D0,D1		; compare chars case sensitive
00:00010A20 6700FFF4        	   138: 	beq	.compare_loop
                            	   139: 
