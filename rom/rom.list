                            	   244: ; Subroutine: b_get_dec_number
                            	   245: ; Inputs:     a0 points to ascii
                            	   246: ; Outputs:    d0.l contains the number (32 bits), d1 contains the number
                            	   247: ;             of digits it consumed (so is 0 when NAN)
                            	   248: ;             a0 remains (1) the same if NAN or (2) points after number
                            	   249: ;-----------------------------------------------------------------------
                            	   250: b_get_dec_number
00:00010B86 2F02            	   251: 	move.l	d2,-(sp)
00:00010B88 4280            	   252: 	clr.l	d0		; will contain end result
00:00010B8A 4281            	   253: 	clr.l	d1		; is zero if NAN
