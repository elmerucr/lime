00:0001074C 0200007F        	   704: 	andi.b	#$7f,D0		; the byte in D1 now contains the current column
00:00010750 66000018        	   705: 	bne	.bs0		; it's column 0
00:00010754 04410031        	   706: 	subi.w	#(T_HPITCH-(T_WIDTH-1)),D1
00:00010758 11BC00201000    	   707: 	move.b	#' ',(A0,D1)
