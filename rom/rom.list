                            	   750: ; Outputs:   -
                            	   751: ; Destroyed: D0,D1,A0,A1
                            	   752: ; ----------------------------------------------------------------------
                            	   753: t_put_hex_number
00:000107B2 4A01            	   754: 	tst.b	D1		; D1 contains no of digits to print
00:000107B4 67000030        	   755: 	beq	.2		; if this is 0, end this function
00:000107B8 5301            	   756: 	subq.b	#1,D1		; reduce number of digits to print by 1
00:000107BA 67000012        	   757: 	beq	.1		; if this is 0 (now), only one digit to print
00:000107BE 2F00            	   758: 	move.l	D0,-(SP)
00:000107C0 E888            	   759: 	lsr.l	#4,D0
00:000107C2 1F01            	   760: 	move.b	D1,-(SP)
