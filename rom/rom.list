00:000106AA 6700002E        	   648: 	beq	.right
00:000106AE B03C0011        	   649: 	cmp.b	#$11,D0			; cursor down
00:000106B2 6700005E        	   650: 	beq	.down
00:000106B6 B03C0091        	   651: 	cmp.b	#$91,D0			; cursor up
00:000106BA 67000060        	   652: 	beq	.up
00:000106BE B03C009D        	   653: 	cmp.b	#$9d,D0			; cursor left
00:000106C2 67000064        	   654: 	beq	.left
00:000106C6 B03C0008        	   655: 	cmp.b	#$08,D0			; backspace
00:000106CA 6700007A        	   656: 	beq	.bs
                            	   657: 
