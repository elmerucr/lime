00:000109C4 48E72000        	    74: 	movem.l	D2,-(SP)
00:000109C8 4202            	    75: 	clr.b	D2		; D2 is flag for string copy mode
                            	    76: 
                            	    77: .start
00:000109CA 1018            	    78: 	move.b	(A0)+,D0
00:000109CC 6700003E        	    79: 	beq	.done		; if null ($00), end of line (regardless D2 flag)
                            	    80: 
00:000109D0 B03C0022        	    81: 	cmp.b	#$22,D0		; check start/stop string mode
00:000109D4 66000006        	    82: 	bne	.1
00:000109D8 0A020001        	    83: 	eor.b	#1,D2
                            	    84: 
00:000109DC 4A02            	    85: .1	tst.b	D2
00:000109DE 66000020        	    86: 	bne	.copy_raw	; we're in string mode
                            	    87: 
                            	    88: 
                            	    89: 	; check for letter
00:000109E2 B03C0061        	    90: 	cmp.b	#'a',D0
00:000109E6 65000018        	    91: 	blo	.copy_raw
00:000109EA B03C007A        	    92: 	cmp.b	#'z',D0
00:000109EE 62000010        	    93: 	bhi	.copy_raw
                            	    94: 
                            	    95: 	; it's a letter: see if there's a match
00:000109F2 5348            	    96: 	subq	#1,A0		; make sure A0 points again to start of potential keyword
00:000109F4 6100001E        	    97: 	bsr	b_check_keyword
00:000109F8 4A00            	    98: 	tst.b	D0		; did we find a token? D0 != 0
00:000109FA 6600000A        	    99: 	bne	.write_token	; yes, go write it
                            	   100: 
                            	   101: 	; if it wasn't, restore char and copy as raw text
00:000109FE 1018            	   102: 	move.b	(A0)+,D0
                            	   103: 
