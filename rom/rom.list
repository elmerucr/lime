00:000108BA D23861B8        	   872: 	add.b	prngc.w,D1
00:000108BE B300            	   873: 	eor.b	D1,D0
00:000108C0 11C061B8        	   874: 	move.b	D0,prngc.w
00:000108C4 4E75            	   875: 	rts
