                            	     6: ;-----------------------------------------------------------------------
                            	     7: ; Calling conventions:
                            	     8: ; - d0-d1/a0-a1 are scratch registers, and need to be caller saved
                            	     9: ;   when to be kept
                            	    10: ; - All other registers must be callee saved (if used by callee)
                            	    11: ; - Calling a trap is an exception, but otherwise works the same as
                            	    12: ;   a conventional function / routine (same scratch registers)
                            	    13: ; - Other (real) exceptions will save and restore all registers
                            	    14: ;
                            	    15: ; Other:
                            	    16: ; - Tab size: 8
                            	    17: ;-----------------------------------------------------------------------
                            	    18: ; rom v0.10
                            	    19: ; adjusted (again) for 320x180 resolution
                            	    20: ;
                            	    21: ; rom v0.9
                            	    22: ; adjusted for 320x176 screen resolution
