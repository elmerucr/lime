00:000104A6 903900006044    	   474: 	sub.b	logo_animation,D0		; subtract logo_an x value from D0
                            	   475: 
00:000104AC B03C0008        	   476: 	cmp.b	#8,D0
00:000104B0 64000008        	   477: 	bcc	.3				; if more than 8, jump to .3
                            	   478: 
00:000104B4 533900000463    	   479: 	subq.b	#1,VDC_SPRITE_Y_LSB		; move letter up 1 pixel
                            	   480: 
00:000104BA 5241            	   481: .3	addq	#1,D1				; move to next sprite
00:000104BC B23C0005        	   482: 	cmp.b	#5,D1				; did we reach sprite 5?
00:000104C0 6600FFD0        	   483: 	bne	.2				; not yet, jump to .2
                            	   484: 
00:000104C4 4CDF0003        	   485: .end	movem.l	(SP)+,D0-D1
00:000104C8 13DF00000407    	   486: 	move.b	(SP)+,VDC_CURRENT_SPRITE
00:000104CE 4E73            	   487: 	rte
