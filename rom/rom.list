                            	   533: ; Subroutine: terminal_putchar
                            	   534: ; Inputs:     D0 contains char to be printed
                            	   535: ; Outputs:    -
                            	   536: ; Destroyed:  D0,D1,A0,A1
                            	   537: ; ----------------------------------------------------------------------
                            	   538: terminal_putchar
