00:00010AE0 4A1A            	   141: 	tst.b	(A2)+		; test table byte and advance pointer
00:00010AE2 6600FFFC        	   142: 	bne	.skip_keyword	; repeat as it wasn't zero
00:00010AE6 528A            	   143: 	addq.l	#1,A2		; it was zero, so advance pointer to skip token value
00:00010AE8 6000FFE0        	   144: 	bra	.loop_keywords	; try next keyword
                            	   145: 
                            	   146: .match_found
00:00010AEC 1012            	   147: 	move.b	(A2),D0		; load token value into D0
00:00010AEE 204B            	   148: 	movea.l	A3,A0		; advance original A0 pointer
00:00010AF0 4CDF0C00        	   149: 	movem.l	(SP)+,A2-A3	; cleanup and return
00:00010AF4 4E75            	   150: 	rts
                            	   151: 
