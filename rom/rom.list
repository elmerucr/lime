00:00010714 4E75            	   686: 	rts
00:00010716 3001            	   687: .l0	move.w	d1,d0
00:00010718 0240007F        	   688: 	andi.w	#$7f,d0
00:0001071C 4A40            	   689: 	tst.w	d0
00:0001071E 6600000A        	   690: 	bne	.l1
00:00010722 0641004F        	   691: 	addi.w	#(T_WIDTH-1),d1
00:00010726 6000FFDC        	   692: 	bra	.up
00:0001072A 5341            	   693: .l1	subq.w	#1,d1
00:0001072C 60C4            	   694: 	bra.s	.2
                            	   695: 
