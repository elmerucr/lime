                            	   747: t_put_hex_number
00:0001079A 4A01            	   748: 	tst.b	d1		; d1 contains no of digits to print
00:0001079C 67000030        	   749: 	beq	.2		; if this is 0, end this function
00:000107A0 5301            	   750: 	subq.b	#1,d1		; reduce number of digits to print by 1
00:000107A2 67000012        	   751: 	beq	.1		; if this is 0 (now), only one digit to print
00:000107A6 2F00            	   752: 	move.l	d0,-(sp)
00:000107A8 E888            	   753: 	lsr.l	#4,d0
00:000107AA 1F01            	   754: 	move.b	d1,-(sp)
